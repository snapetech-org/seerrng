PROJECT=seerrng
GITHUB_REPOSITORY=snapetech-org/seerrng
BINARY=seerrng
VERSION_ARGS=
DEFAULT_PORT=5055
HEALTH_PATH=/api/v1/status
LINUX_ARCHIVE_ASSET=seerrng-${version}-linux-x64.tar.gz
LINUX_ARM64_ARCHIVE_ASSET=seerrng-${version}-linux-arm64.tar.gz
MACOS_ARCHIVE_ASSET=seerrng-${version}-macos-arm64.tar.gz
WINDOWS_ARCHIVE_ASSET=seerrng-${version}-windows-x64.zip
GHCR_IMAGE=ghcr.io/snapetech-org/seerrng
DOCKERHUB_IMAGE=snapetech/seerrng
AUR_PACKAGES="seerrng-bin"
AUR_BIN_PACKAGE=seerrng-bin
COPR_REPO=slskdn/seerrng
PPA=${PPA:-ppa:keefshape/seerrng}
SNAP_NAME=seerrng
FLATPAK_MANIFEST=packaging/flatpak/io.github.snapetech.seerrng.yml
HELM_CHART=charts/seerr-chart
CHOCO_PACKAGE=seerrng
PUBLISHED_CHANNELS="github-archive deb rpm container-ghcr container-dockerhub aur-bin copr ppa snap chocolatey flatpak helm"
