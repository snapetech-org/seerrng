<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>seerrng</id>
    <version>__VERSION__</version>
    <title>SeerrNG</title>
    <authors>SeerrNG contributors</authors>
    <owners>snapetech</owners>
    <copyright>Copyright 2026 SeerrNG contributors</copyright>
    <licenseUrl>https://github.com/snapetech-org/seerrng/blob/main/LICENSE</licenseUrl>
    <projectUrl>https://github.com/snapetech-org/seerrng</projectUrl>
    <packageSourceUrl>https://github.com/snapetech-org/seerrng</packageSourceUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Self-hosted media request and discovery manager.</summary>
    <description>SeerrNG helps users discover and request media from connected services. This package installs the Windows x64 release as the SeerrNG service and retains its configuration when the package is removed.</description>
    <tags>seerrng seerr media requests discovery sonarr radarr</tags>
    <dependencies>
      <dependency id="nodejs-lts" version="[24.15.0,25.0.0)" />
      <dependency id="nssm" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
