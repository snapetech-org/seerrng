FROM node:24.21.0-alpine3.23@sha256:9ec4a2e289874ed0d722e1772ec2de45d2801541db8612f3638b26f128c69ac2

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN apk add --no-cache python3 py3-setuptools make g++ gcc libc6-compat
RUN corepack enable

COPY --chown=node:node . /app
WORKDIR /app

RUN mkdir -p /app/node_modules /app/.next "$PNPM_HOME" && \
  chown node:node /app/node_modules /app/.next "$PNPM_HOME"
USER node:node

RUN pnpm install

CMD pnpm dev
