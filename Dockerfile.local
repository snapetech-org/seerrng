FROM node:24.22.2-alpine3.23@sha256:9b69af715c7f9d038150b54ccccbaeffa9064bbc93e2904c29591ca097316af1

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN apk add --no-cache python3 py3-setuptools make g++ gcc libc6-compat && \
  apk upgrade --no-cache zlib
RUN corepack enable

COPY --chown=node:node . /app
WORKDIR /app

RUN mkdir -p /app/node_modules /app/.next "$PNPM_HOME" && \
  chown node:node /app/node_modules /app/.next "$PNPM_HOME"
USER node:node

RUN pnpm install

CMD pnpm dev
