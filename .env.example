# Optional Karaoke Mugen integration. Credentials are read only by the SeerrNG server.
SEERRNG_KARAOKE_MUGEN_URL=
SEERRNG_KARAOKE_MUGEN_USERNAME=
SEERRNG_KARAOKE_MUGEN_PASSWORD=
# Optional URL opened by browsers for the lyrics/player display.
SEERRNG_KARAOKE_MUGEN_PLAYER_URL=

# Maximum number of concurrent TMDB movie/TV detail lookups used to enrich search
# results per SeerrNG server process. Keep this between 8 and 16 for normal
# deployments; lower it if the TMDB account approaches its 40 requests per 10
# second rate limit.
SEARCH_CREDIT_CONCURRENCY=10

# Expose the Prometheus metrics endpoint at /metrics. Requests also require the
# bearer token below; leave disabled unless the endpoint is on a trusted network.
METRICS_ENABLED=false
METRICS_AUTH_TOKEN=
