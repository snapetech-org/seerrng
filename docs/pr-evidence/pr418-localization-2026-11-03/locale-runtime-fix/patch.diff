diff --git a/src/utils/localeHint.ts b/src/utils/localeHint.ts
index 5e291c8..4ca50f1 100644
--- a/src/utils/localeHint.ts
+++ b/src/utils/localeHint.ts
@@ -1 +1 @@
-import type { AvailableLocale } from '@server/types/languages';
+import { isAvailableLocale, type AvailableLocale } from '@server/types/languages';
@@ -4,0 +5,18 @@ const localeHintCookieName = 'seerrng-locale';
+export const getLocaleHintCookie = (): AvailableLocale | null => {
+  if (typeof document === 'undefined') return null;
+
+  for (const cookie of document.cookie.split(';')) {
+    const [name, ...valueParts] = cookie.trim().split('=');
+    if (name !== localeHintCookieName) continue;
+
+    try {
+      const value = decodeURIComponent(valueParts.join('='));
+      return isAvailableLocale(value) ? value : null;
+    } catch {
+      return null;
+    }
+  }
+
+  return null;
+};
+
