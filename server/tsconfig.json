{
  "extends": "../tsconfig.json",
  "ts-node": {
    "compilerOptions": {
      "allowJs": false
    }
  },
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../dist",
    "rootDir": ".",
    "noEmit": false,
    "incremental": true,
    "paths": {
      "@server/*": ["./*"],
      "@app/*": ["../src/*"],
      "@themes/*": ["../themes/*"]
    },
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts", "test/**/*.ts"]
}
