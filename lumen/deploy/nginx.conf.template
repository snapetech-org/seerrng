# One origin for the app and SeerrNG's API, so SeerrNG's sign-in cookie just works.
#   SEERR_URL         SeerrNG's API (e.g. http://seerrng:5055);
#                     SEERR_INTERNAL_URL also sets it (05-lumen-env-aliases.envsh)
#   SEERR_EXTRAS_URL  optional companion proxy (ChaptarrNG lookups, "request another narrator")
#   SEERR_FULL_URL    where people reach full SeerrNG for pages Lumen doesn't have;
#                     SEERR_BROWSER_URL also sets it (05-lumen-env-aliases.envsh)

# The visitor's address. SeerrNG trusts one proxy hop (Lumen), so whatever Lumen forwards is the
# IP SeerrNG rate-limits sign-ins by. $remote_addr is the address that connected, or, when that is
# a proxy listed in LUMEN_TRUSTED_PROXIES, the visitor that proxy reported (realip module, set up by
# 15-lumen-trusted-proxies.sh). Headers sent by anyone else are never passed on.
# The scheme is likewise taken from X-Forwarded-Proto only when a trusted proxy sent it.
map "$lumen_via_proxy:$http_x_forwarded_proto" $lumen_forwarded_proto {
  default $scheme;
  "1:https" https;
  "1:http" http;
}

# The same protections full SeerrNG sends with its pages: no framing (clickjacking), scripts only
# from this origin. Outside hosts: Google Fonts, Plex sign-in, and cover art from many CDNs.
# saves "Lumen settings for everyone" from the admin page (see lumen-config.js)
js_import lumen from /etc/nginx/lumen/lumen-config.js;

map "" $lumen_csp {
  default "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://plex.tv https://*.plex.tv; manifest-src 'self'; worker-src 'self'; frame-src 'none'";
}

server {
  listen 80;
  root /usr/share/nginx/html;
  server_tokens off;
  set $lumen_runtime_uid "${LUMEN_RUNTIME_UID}";
  set $lumen_runtime_gid "${LUMEN_RUNTIME_GID}";

  # security headers (repeated in each location below that sets headers of its own)
  add_header Content-Security-Policy $lumen_csp;
  add_header X-Frame-Options DENY;
  add_header X-Content-Type-Options nosniff;
  add_header Referrer-Policy same-origin;

  location /api/ {
    proxy_pass ${SEERR_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    # never pass on a client's own copies of other forwarding headers
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Proto $lumen_forwarded_proto;
  }
  location ~ ^/(imageproxy|avatarproxy)/ {
    proxy_pass ${SEERR_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Proto $lumen_forwarded_proto;
  }
  # Companion services must still enforce their own per-user permissions and quotas.
  # Check the current SeerrNG session before forwarding any companion request.
  location = /_lumen_session_check {
    internal;
    proxy_pass ${SEERR_URL}/api/v1/auth/me;
    proxy_method GET;
    # njs parses the JSON body itself; it cannot decode upstream gzip/brotli.
    proxy_set_header Accept-Encoding "";
    # lumen-config.js reads the answer (who is signed in), not just the status
    subrequest_output_buffer_size 64k;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Proto $lumen_forwarded_proto;
  }
  location /seerr-classic/ {
    auth_request /_lumen_session_check;
    proxy_pass ${SEERR_EXTRAS_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    # never pass on a client's own copies of other forwarding headers
    proxy_set_header CF-Connecting-IP "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Proto $lumen_forwarded_proto;
  }

  # "Lumen settings for everyone": the admin page saves them here (PUT, SeerrNG admins only)
  # when /lumen-data is mounted and writable; GET says whether it is
  location = /lumen/config {
    client_max_body_size 64k;
    client_body_buffer_size 64k;
    js_content lumen.save;
  }
  # logo and tab icon uploaded from the admin page (PUT, SeerrNG admins only)
  location ^~ /lumen/branding/ {
    client_max_body_size 2m;
    client_body_buffer_size 2m;
    js_content lumen.branding;
  }
  # /branding/: uploads first, then a branding folder mounted into the app. Images only, so
  # nothing here may run scripts (an SVG opened on its own included).
  location /branding/ {
    add_header Cache-Control "no-cache";
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox";
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy same-origin;
    root /lumen-data;
    try_files $uri @branding_mounted;
  }
  location @branding_mounted {
    add_header Cache-Control "no-cache";
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; sandbox";
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy same-origin;
    root /usr/share/nginx/html;
    try_files $uri =404;
  }
  # settings saved from the admin page win over a lumen-config.json mounted into the app
  location = /lumen-config.json {
    add_header Cache-Control "no-cache";
    add_header Content-Security-Policy $lumen_csp;
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy same-origin;
    root /lumen-data;
    try_files /lumen-config.json @lumen_config_mounted;
  }
  location @lumen_config_mounted {
    add_header Cache-Control "no-cache";
    add_header Content-Security-Policy $lumen_csp;
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy same-origin;
    root /usr/share/nginx/html;
    try_files /lumen-config.json =404;
  }

  # "open full SeerrNG" links when lumen-config.json sets no seerrPublicUrl
  location = /seerrng {
    return 302 ${SEERR_FULL_URL}/?interface=classic;
  }

  # SeerrNG pages Lumen doesn't have (links in emails, old bookmarks): open them in full SeerrNG
  location ~ ^/(issues|settings|users|profile|collection|person|discover|calendar|blocklist|setup|swipe|following|library|downloads|recordings|share|identify|indexer-search|track-requests|book-series|author|software|franchise|collections|associations|resetpassword)(/|$) {
    return 302 ${SEERR_FULL_URL}$request_uri;
  }

  # replaces SeerrNG's service worker; must never be cached or the old one lingers
  location = /sw.js {
    add_header Cache-Control "no-store";
    add_header Content-Security-Policy $lumen_csp;
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy same-origin;
    try_files $uri =404;
  }
  location = /manifest.webmanifest {
    default_type application/manifest+json;
    try_files $uri =404;
  }
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header Content-Security-Policy $lumen_csp;
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy same-origin;
  }
  # client-side routes (/movie/123, /books, ...) all load the app
  location / {
    add_header Cache-Control "no-cache";
    add_header Content-Security-Policy $lumen_csp;
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy same-origin;
    try_files $uri /index.html;
  }
}
